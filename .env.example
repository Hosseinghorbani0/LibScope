# ==============================================================================
# LibScope Configuration (.env.example)
# Open-Source Software Intelligence Platform. Beyond Downloads.
# ==============================================================================

# Server & API Configuration
LIBSCOPE_HOST=0.0.0.0
LIBSCOPE_PORT=8000
LIBSCOPE_DEBUG=false
LIBSCOPE_LOG_LEVEL=INFO
LIBSCOPE_ENVIRONMENT=production

# CORS Origins (comma-separated, or * for permissive development)
LIBSCOPE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Configuration
# SQLite (default for single-node / local evaluation):
LIBSCOPE_DATABASE_URL=sqlite:///./data/libscope.db
# PostgreSQL (recommended for production):
# LIBSCOPE_DATABASE_URL=postgresql+psycopg2://libscope:libscope_password@localhost:5432/libscope

# Rate Limiting & Networking
LIBSCOPE_REQUEST_TIMEOUT=15.0
LIBSCOPE_MAX_RETRIES=3
LIBSCOPE_RETRY_BACKOFF_FACTOR=1.5
LIBSCOPE_CACHE_TTL_SECONDS=3600

# GitHub Integration (Optional - unauthenticated rate limit is 60 req/hr, with token is 5000 req/hr)
# Also respects standard GH_TOKEN or GITHUB_TOKEN environment variables
GITHUB_TOKEN=
# GH_TOKEN=

# AI Provider Configuration (Optional - platform remains fully functional without AI)
# Supported providers: "openrouter", "openai", "gemini", "anthropic", "disabled"
LIBSCOPE_AI_PROVIDER=openrouter
LIBSCOPE_AI_API_KEY=
# Model selection (e.g. "openai/gpt-4o-mini", "anthropic/claude-3-haiku", "google/gemini-2.0-flash-001")
LIBSCOPE_AI_MODEL=openai/gpt-4o-mini
# Custom Base URL (if using self-hosted LLM or alternative proxy)
LIBSCOPE_AI_BASE_URL=https://openrouter.ai/api/v1
LIBSCOPE_AI_TEMPERATURE=0.2
LIBSCOPE_AI_MAX_TOKENS=2048

# Security & Sandbox Guard
# Protect against SSRF: strict blocklist of private/loopback/cloud metadata IP ranges
LIBSCOPE_ENFORCE_SSRF_PROTECTION=true

